// Dictora — shared build configuration.
//
// Bundle identifiers are defined here (and only here) so they can be re-pointed
// at a real organisation without touching project.yml or any target settings.

DICTORA_BUNDLE_ID_BASE = com.dictora.app
DICTORA_BUNDLE_ID_MAC = $(DICTORA_BUNDLE_ID_BASE)
DICTORA_BUNDLE_ID_IOS = $(DICTORA_BUNDLE_ID_BASE).ios

// Future extension targets should extend the base identifier, e.g.
// DICTORA_BUNDLE_ID_IOS_KEYBOARD = $(DICTORA_BUNDLE_ID_IOS).keyboard

// Both apps build a bundle called Dictora.app. Test targets derive TEST_HOST
// from this, so it must stay in sync with PRODUCT_NAME.
DICTORA_PRODUCT_NAME = Dictora
DICTORA_DISPLAY_NAME = Dictora

MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1

// Apple Developer Team ID.
//
// This is not optional on macOS. An ad-hoc signature ("-") pins every TCC
// permission — Accessibility above all — to the binary's exact code hash, so
// each rebuild silently invalidates the grant: System Settings keeps showing
// Dictora switched on while AXIsProcessTrusted() returns false. Signing with a
// real certificate makes the requirement team + bundle ID instead, which
// survives rebuilds.
//
// Change this to your own Team ID. `security find-identity -v -p codesigning`
// lists the certificates installed on your Mac; note that the ID shown there in
// brackets is the certificate's user ID, not always the Team ID. To read the
// Team ID itself, build once and run:
//   codesign -dv --verbose=2 <path to Dictora.app>
DEVELOPMENT_TEAM = L65T759ZGZ
